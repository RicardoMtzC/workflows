{
  "_test": {
    "timeout_s": 3000,
    "warm_marker": "${HOME}/pw/software/containers/kasmvnc-rocky9-gpu.sif",
    "leftover_patterns": [
      "Xvnc",
      "kasmvnc",
      "pw endpoints http"
    ]
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "00:30:00"
    }
  },
  "desktop": {
    "kasmvnc_os": "rocky9"
  }
}
