{
  "_test": {
    "timeout_s": 3600,
    "endpoint": true,
    "warm_marker": [
      "${HOME}/pw/software/openfoam-naca/paraview/ParaView-6.1.1/.render-checked"
    ],
    "leftover_patterns": [
      "pw endpoints",
      "design-explorer-server.py",
      "simpleFoam",
      "blockMesh",
      "pvpython"
    ]
  },
  "resource": "pw://mshaxted/nautilus",
  "cluster": {
    "scheduler": false
  },
  "doe": {
    "method": "one_at_a_time",
    "n_cases": 9,
    "max_parallel": 4,
    "mesh_scale": 1
  },
  "software": {
    "openfoam_load": "module load openfoam/Intel/v2512\nsource $foamDotFile\n"
  }
}
