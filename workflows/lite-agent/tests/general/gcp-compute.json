{
  "_test": {
    "timeout_s": 1800,
    "warm_marker": "${HOME}/pw/software/agent-venv",
    "leftover_patterns": [
      "agent_server",
      "pw endpoints run"
    ]
  },
  "cluster": {
    "resource": "pw://alvaro/gcpsmall",
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "00:30:00"
    }
  },
  "service": {
    "model": "org:glm/glm-5.1",
    "allocation": "Owners"
  }
}
