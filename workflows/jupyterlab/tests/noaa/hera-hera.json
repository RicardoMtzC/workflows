{
  "_test": {
    "timeout_s": 3600,
    "warm_marker": "${HOME}/.local/bin/jupyter-lab",
    "leftover_patterns": [
      "jupyter",
      "pw endpoints run"
    ]
  },
  "resource": "pw://Alvaro.Vidal/noaaheracluster",
  "cluster": {
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "account": "nesccmgmt",
      "partition": "hera",
      "qos": "debug",
      "ntasks": 1,
      "nodes": 1,
      "time": "00:15:00"
    }
  },
  "service": {
    "notebook_dir": "${HOME}",
    "conda_install": true,
    "use_conda": false,
    "load_env_tag_existing": "export PATH=$PATH:/home/${USER}/.local/bin; module load python",
    "install_command": "export PATH=$PATH:/home/${USER}/.local/bin; module load python; pip install jupyterlab --no-warn-script-location"
  }
}
