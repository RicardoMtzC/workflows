{
  "_test": {
    "timeout_s": 1800,
    "warm_marker": "${HOME}/pw/software/.miniconda3c-artifact",
    "leftover_patterns": ["jupyter-lab", "pw endpoints run"]
  },
  "cluster": {
    "resource": "pw://alvaro/gcpsmall",
    "scheduler": false
  },
  "service": {
    "notebook_dir": "${HOME}",
    "conda_install": true,
    "parent_install_dir": "${HOME}/pw/software",
    "conda_install_dir": ".miniconda3c-artifact",
    "conda_env": "base",
    "conda_source": "artifact",
    "install_instructions": "jupyterlab4.1.5-python3.11.5"
  }
}
