{
  "_test": {
    "timeout_s": 1800,
    "warm_marker": "${HOME}/pw/software/.miniconda3c-legacy",
    "setup": "p=${HOME}/pw/software/.miniconda3c-legacy; if [ -d \"$p\" ]; then rm -rf \"$p/.pw-jupyterlab-conda-source\" \"$p/.pw-env-markers\"; fi",
    "leftover_patterns": ["jupyter-lab", "pw endpoints run"]
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": false
  },
  "service": {
    "notebook_dir": "${HOME}",
    "conda_install": true,
    "parent_install_dir": "${HOME}/pw/software",
    "conda_install_dir": ".miniconda3c-legacy",
    "conda_env": "base",
    "conda_source": "artifact",
    "install_instructions": "jupyterlab4.1.5-python3.11.5"
  }
}
