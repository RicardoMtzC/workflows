{
  "_test": {
    "timeout_s": 3600,
    "warm_marker": "${HOME}/pw/software/.miniconda3cn",
    "leftover_patterns": [
      "jupyter",
      "pw endpoints run"
    ]
  },
  "resource": "pw://Alvaro.Vidal/googlerocky9",
  "cluster": {
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "01:00:00"
    }
  },
  "service": {
    "notebook_dir": "${HOME}",
    "conda_install": true,
    "parent_install_dir": "${HOME}/pw/software",
    "conda_install_dir": ".miniconda3cn",
    "conda_env": "base",
    "install_instructions_tag_cloud": "notebook7.2.2-python3.12.2"
  }
}
