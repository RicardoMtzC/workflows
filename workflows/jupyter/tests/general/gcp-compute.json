{
  "_test": {
    "timeout_s": 2400,
    "warm_marker": "${HOME}/pw/software/.miniconda3cn",
    "leftover_patterns": [
      "jupyter",
      "pw endpoints run"
    ]
  },
  "cluster": {
    "resource": "pw://alvaro/gcpsmall",
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "00:30:00"
    }
  },
  "service": {
    "notebook_dir": "${HOME}",
    "conda_install": true,
    "parent_install_dir": "${HOME}/pw/software",
    "conda_install_dir": ".miniconda3cn",
    "conda_env": "base",
    "install_instructions": "latest"
  }
}
