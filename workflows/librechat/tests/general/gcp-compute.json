{
  "_test": {
    "timeout_s": 3000,
    "warm_marker": "${HOME}/pw/software/containers/librechat",
    "leftover_patterns": [
      "librechat",
      "mongod",
      "meilisearch",
      "pw endpoints run"
    ]
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "00:30:00"
    }
  },
  "service": {
    "librechat_dir": "${HOME}/pw/LibreChat",
    "domain_client": "ACTIVATE"
  }
}
