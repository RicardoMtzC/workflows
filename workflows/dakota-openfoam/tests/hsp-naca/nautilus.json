{
  "_test": {
    "timeout_s": 3600,
    "endpoint": true,
    "warm_marker": [
      "${HOME}/pw/software/dakota/miniforge/envs/dakota"
    ],
    "leftover_patterns": [
      "pw endpoints",
      "design-explorer-server.py",
      "bin/dakota",
      "app/driver.py",
      "simpleFoam",
      "blockMesh"
    ]
  },
  "resource": "pw://mshaxted/nautilus",
  "cluster": {
    "scheduler": false
  },
  "optimizer": {
    "max_iterations": 4,
    "batch_size": 4,
    "stall_generations": 3,
    "mesh_scale": 1
  },
  "software": {
    "openfoam_load": "module load openfoam/Intel/v2512\nsource $foamDotFile\n"
  }
}
