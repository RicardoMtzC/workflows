{
  "_test": {
    "timeout_s": 3600,
    "endpoint": true,
    "warm_marker": [
      "${HOME}/pw/software/openfoam-naca/miniforge/envs/openfoam",
      "${HOME}/pw/software/dakota/miniforge/envs/dakota"
    ],
    "leftover_patterns": [
      "pw endpoints",
      "design-explorer-server.py",
      "bin/dakota",
      "app/driver.py",
      "simpleFoam",
      "blockMesh",
      "mpirun",
      "hydra_pmi_proxy"
    ]
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": true,
    "cores_per_case": 2,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "00:30:00",
      "scheduler_directives": ""
    }
  },
  "optimizer": {
    "max_iterations": 3,
    "batch_size": 4,
    "stall_generations": 3,
    "mesh_scale": 1
  }
}
