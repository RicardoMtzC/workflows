{
  "_test": {
    "timeout_s": 5400,
    "endpoint": true,
    "warm_marker": [
      "${HOME}/pw/software/openfoam-naca/miniforge/envs/openfoam",
      "${HOME}/pw/software/dakota/miniforge/envs/dakota"
    ],
    "leftover_patterns": ["pw endpoints", "design-explorer-server.py", "bin/dakota", "app/driver.py", "simpleFoam", "blockMesh", "mpirun", "hydra_pmi_proxy"]
  },
  "cluster": {
    "resource": "pw://alvaro/gcpsmall",
    "scheduler": true,
    "cores_per_case": 4,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "01:00:00",
      "scheduler_directives": ""
    }
  },
  "optimizer": {
    "max_iterations": 10,
    "batch_size": 8,
    "stall_generations": 3,
    "mesh_scale": 3,
    "iteration_timeout": "2d"
  }
}
