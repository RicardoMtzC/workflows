{
  "_test": {
    "timeout_s": 3600,
    "warm_marker": [
      "${HOME}/spk/bin/spack",
      "${HOME}/spack-buildcache/v3"
    ],
    "leftover_patterns": [
      "pw endpoints",
      "spack install",
      "http.server"
    ]
  },
  "cluster": {
    "resource": "gce",
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "cpu",
      "time": "00:20:00",
      "build_time": "06:00:00"
    },
    "build_on": "compute"
  },
  "service": {
    "spack_version": "v1.2.2",
    "install_prefix": "${HOME}/spk",
    "buildcache_path": "${HOME}/spack-buildcache",
    "build_jobs": 4,
    "concretize_only": false,
    "build_gpu": false,
    "use_overrides": false
  }
}
