{
  "_test": {
    "timeout_s": 64800,
    "warm_marker": [
      "${HOME}/spk-gpu/bin/spack",
      "${HOME}/spack-buildcache/v3"
    ],
    "leftover_patterns": [
      "pw endpoints",
      "spack install",
      "http.server"
    ]
  },
  "cluster": {
    "resource": "aws",
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "gpu",
      "time": "00:30:00",
      "gpus": 0
    },
    "build_on": "login"
  },
  "service": {
    "spack_version": "v1.2.2",
    "install_prefix": "${HOME}/spk-gpu",
    "buildcache_path": "${HOME}/spack-buildcache",
    "build_jobs": 2,
    "concretize_only": false,
    "build_gpu": true,
    "use_overrides": false
  }
}
