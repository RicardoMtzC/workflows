{
  "_test": {
    "timeout_s": 1800,
    "warm_marker": "${HOME}/postgres/pgdata/PG_VERSION",
    "secrets": {
      "service.password": "POSTGRES_TEST_PASSWORD"
    },
    "leftover_patterns": [
      "pw endpoints run",
      "docker compose"
    ]
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "01:00:00"
    }
  },
  "service": {
    "user": "postgres",
    "db": "postgres",
    "port": 5432,
    "data_dir": "${HOME}/postgres",
    "image": "postgres:18"
  }
}
