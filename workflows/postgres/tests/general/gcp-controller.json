{
  "_test": {
    "timeout_s": 1800,
    "warm_marker": "${HOME}/postgres/pgdata/PG_VERSION",
    "secrets": {
      "service.password": "POSTGRES_TEST_PASSWORD"
    },
    "leftover_patterns": [
      "pw endpoints run",
      "docker compose",
      "/usr/bin/pgweb",
      "postgres: checkpointer"
    ],
    "leftover_commands": {
      "docker_containers": "(docker ps -aq --filter name=postgres_ 2>/dev/null || sudo -n docker ps -aq --filter name=postgres_ 2>/dev/null || echo ERR) | wc -l"
    }
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": false
  },
  "service": {
    "user": "postgres",
    "db": "postgres",
    "port": 5432,
    "data_dir": "${HOME}/postgres",
    "image": "postgres:18"
  }
}
