{
  "_test": {
    "timeout_s": 2700,
    "endpoint": true,
    "warm_marker": [
      "${HOME}/pw/software/physicsnemo/src/physicsnemo-v1.1.0/.complete",
      "${HOME}/pw/software/physicsnemo/miniforge/envs/tensorboard/bin/python"
    ],
    "leftover_patterns": [
      "pw endpoints",
      "tensorboard-server.py",
      "run-example.sh"
    ],
    "leftover_commands": {
      "containers": "sudo -n docker ps -q --filter name=physicsnemo- | wc -l"
    }
  },
  "resource": "pw://alvaro/a30gpuserver",
  "cluster": {
    "scheduler": true,
    "gpus": 0,
    "slurm": {
      "is_enabled": true,
      "partition": "debug",
      "time": "00:30:00"
    }
  },
  "service": {
    "mode": "example",
    "example": "darcy_fno",
    "epochs": 2,
    "device": "gpu",
    "tensorboard": true
  },
  "software": {
    "runtime": "docker"
  }
}
