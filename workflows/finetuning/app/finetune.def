Bootstrap: docker
From: nvidia/cuda:12.4.1-devel-ubuntu22.04
# NOTE: HANDOFF.md sec3.5's anchor set targets CUDA 12.9; 12.4.1-devel is used
# here as a widely-available, publicly pullable Docker Hub tag with a matching
# devel toolchain (nvcc/ptxas) for Triton's JIT compilation. torch/triton
# themselves come from the cu128 pip wheels pinned in requirements.txt, which
# is what actually determines the CUDA runtime used at training time -- bump
# this base tag if a newer public one becomes available, it is not
# load-bearing for correctness the way the pip pins are.
#
# Target host for TRUE MXFP4 execution (gpt-oss profiles): Hopper-class GPU
# (compute capability >= 9.0: H100/H200/B100) with a CUDA 12.x driver.
# On older cards (e.g. this repo's T4 dev box, capability 7.5) transformers
# dequantizes MXFP4 to bf16 automatically -- training still works, see
# app/train.py's gpu_supports_hopper_mxfp4() check. Building this image does
# NOT require a GPU.
#
# singularity and apptainer are interchangeable here.

%files
    requirements.txt /opt/finetune/requirements.txt

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev git git-lfs ca-certificates
    rm -rf /var/lib/apt/lists/*
    python3 -m pip install --no-cache-dir --upgrade pip

    # Two installs, each with a SINGLE --index-url, instead of one install with
    # --extra-index-url. --extra-index-url makes pip merge PyPI and the cu128
    # index and take the highest version found across BOTH, so a package
    # published to PyPI under a name the cu128 index also serves can win the
    # resolution. Scoping each install to one index removes that merge.
    #
    # The torch pin is read back out of requirements.txt rather than repeated
    # here: build-container.sh stages either requirements.txt or
    # requirements-tf5.txt at this path, and the pin set stays the single
    # source of truth for what version is installed.
    torch_pin=$(grep -E '^torch==' /opt/finetune/requirements.txt || true)
    if [ -z "${torch_pin}" ]; then
        echo "no 'torch==' pin found in /opt/finetune/requirements.txt" >&2
        exit 1
    fi
    python3 -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu128 "${torch_pin}"
    python3 -m pip install --no-cache-dir \
        --index-url https://pypi.org/simple -r /opt/finetune/requirements.txt

    # Fragile piece (HANDOFF sec3.5): install explicitly, separately from the
    # pinned requirements.txt, so a version bump here stays easy to spot.
    python3 -m pip install --no-cache-dir \
        --index-url https://pypi.org/simple triton-kernels==0.1.0

%test
    python3 -c "import torch, transformers, peft, trl, accelerate; print('deps ok')"
    python3 -c "import torch; print('cuda available (build host, expected False unless GPU-visible):', torch.cuda.is_available())"
    # Egress guard, not a dependency check. transformers' Trainer defaults to
    # report_to="all", which auto-enables ANY tracker SDK it can import and
    # ships loss curves and hyperparameters to that vendor's service with no
    # code change. app/train.py sets report_to explicitly, but keeping the
    # image free of these means a future code path cannot opt in by accident.
    # Fail the BUILD if one is ever pulled in as a transitive dependency.
    python3 -c "import importlib.util as u; bad = [m for m in ('wandb', 'mlflow', 'comet_ml', 'clearml', 'neptune', 'dvclive', 'codecarbon', 'sentry_sdk', 'posthog') if u.find_spec(m) is not None]; assert not bad, 'telemetry/tracker SDK present in image: %s' % bad; print('no tracker SDKs: ok')"

%labels
    org.opencontainers.image.source https://github.com/parallelworks/workflows
    org.opencontainers.image.description Singularity image for the generalized LoRA/QLoRA finetuning ACTIVATE workflow (dense + MoE, gpt-oss MXFP4-aware)

%help
    Training entrypoint:
      singularity exec --nv finetune.sif python3 /path/to/app/train.py --help
    Built by app/build-container.sh (standalone, no workflow dependency).
