{
  "_test": {
    "timeout_s": 1800,
    "warm_marker": "${HOME}/filebrowser/database/filebrowser.db",
    "leftover_patterns": [
      "filebrowser --config",
      "docker compose",
      "pw endpoints run"
    ],
    "leftover_commands": {
      "docker_containers": "(docker ps -aq --filter name=filebrowser_ 2>/dev/null || sudo -n docker ps -aq --filter name=filebrowser_ 2>/dev/null || echo ERR) | wc -l"
    }
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": false
  },
  "service": {
    "data_dir": "${HOME}/filebrowser/data",
    "rundir": "${HOME}/filebrowser",
    "auth_method": "noauth"
  }
}
