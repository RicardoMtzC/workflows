{
  "_test": {
    "timeout_s": 2400,
    "warm_marker": "${HOME}/pw/software/containers/n8n.sif",
    "leftover_patterns": [
      "n8n",
      "pw endpoints run"
    ]
  },
  "cluster": {
    "resource": "pw://alvaro/gcpsmall",
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "00:30:00"
    }
  },
  "service": {
    "container_runtime": "n8n-singularity",
    "n8n_data_dir": "${HOME}/pw/n8n"
  }
}
