{
  "_test": {
    "timeout_s": 3600,
    "warm_marker": "${HOME}/pw/containers/n8n.sif",
    "leftover_patterns": [
      "n8n",
      "pw endpoints run"
    ]
  },
  "resource": "pw://Alvaro.Vidal/googlerocky9",
  "cluster": {
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "01:00:00"
    }
  },
  "service": {
    "container_runtime": "n8n-singularity",
    "n8n_data_dir": "${HOME}/pw/n8n"
  }
}
