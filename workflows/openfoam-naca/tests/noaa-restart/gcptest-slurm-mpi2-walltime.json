{
  "_test": {
    "timeout_s": 3600,
    "endpoint": false,
    "warm_marker": "${HOME}/pw/software/openfoam-naca/miniforge/envs/openfoam",
    "leftover_patterns": ["simpleFoam", "potentialFoam", "blockMesh", "simulator.sh", "mpirun", "hydra_pmi_proxy"]
  },
  "resource": "pw://alvaro/gcptest",
  "cluster": {
    "scheduler": true,
    "cores_per_case": 2,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "00:02:00",
      "scheduler_directives": ""
    }
  },
  "case": {
    "max_camber": 0.02,
    "camber_position": 0.4,
    "thickness": 0.12,
    "angle_of_attack": 5,
    "mesh_scale": 3
  },
  "restart": {
    "max_restarts": 10,
    "attempt_timeout": "30m",
    "checkpoint_every": 100,
    "keep_checkpoints": 2
  }
}
