{
  "_test": {
    "timeout_s": 900,
    "endpoint": false,
    "expect": "error",
    "warm_marker": "${HOME}/pw/software/openfoam-naca/miniforge/envs/openfoam",
    "leftover_patterns": ["simpleFoam", "potentialFoam", "blockMesh", "simulator.sh", "mpirun", "hydra_pmi_proxy"]
  },
  "resource": "pw://alvaro/gcptest",
  "cluster": {
    "scheduler": false,
    "cores_per_case": 16
  },
  "case": {
    "max_camber": 0.05,
    "camber_position": 0.4,
    "thickness": 0.12,
    "angle_of_attack": 5,
    "mesh_scale": 1
  },
  "restart": {
    "max_restarts": 3,
    "attempt_timeout": "10m",
    "checkpoint_every": 100,
    "keep_checkpoints": 2
  },
  "software": {
    "openfoam_load": "source ${service_parent_install_dir:-$HOME/pw/software}/openfoam-naca/miniforge/etc/profile.d/conda.sh\nconda activate openfoam\nexport MIN_CELLS_PER_RANK=0"
  }
}
