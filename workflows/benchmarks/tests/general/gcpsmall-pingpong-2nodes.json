{
  "_test": {
    "timeout_s": 1800,
    "endpoint": false,
    "warm_marker": "${HOME}/pw/software/benchmarks/usr_lib64_openmpi/imb-2021.11/IMB-MPI1",
    "leftover_patterns": ["IMB-MPI1", "mpirun"]
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": true,
    "nodes": 2,
    "ntasks_per_node": 2,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "00:30:00"
    }
  },
  "benchmark": {
    "name": "imb-pingpong"
  },
  "software": {
    "mpi": "auto"
  }
}
