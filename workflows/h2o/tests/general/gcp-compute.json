{
  "_test": {
    "timeout_s": 2400,
    "warm_marker": "${HOME}/pw/software/h2o-3.46.0.12/h2o.jar",
    "leftover_patterns": ["h2o.jar", "pw endpoints run"]
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": true,
    "slurm": {
      "is_enabled": true,
      "partition": "compute",
      "time": "00:30:00"
    }
  },
  "service": {
    "download_url": "https://h2o-release.s3.amazonaws.com/h2o/rel-3.46.0/12/h2o-3.46.0.12.zip",
    "jvm_args": "-Xmx2g",
    "parent_install_dir": "${HOME}/pw/software"
  }
}
