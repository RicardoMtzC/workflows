{
  "_test": {
    "timeout_s": 900,
    "expect": "error",
    "warm_marker": "${HOME}/pgadmin4/pgadmin4.db",
    "leftover_patterns": [
      "pw endpoints run",
      "docker compose",
      "run_pgadmin:app"
    ],
    "leftover_commands": {
      "docker_containers": "(docker ps -aq --filter name=pgadmin4_ 2>/dev/null || sudo -n docker ps -aq --filter name=pgadmin4_ 2>/dev/null || echo ERR) | wc -l"
    }
  },
  "resource": "pw://alvaro/gcpsmall",
  "cluster": {
    "scheduler": false
  },
  "service": {
    "email": "admin@example.com",
    "password": "not-the-password-the-data-directory-was-created-with",
    "data_dir": "${HOME}/pgadmin4",
    "server": {
      "host": ""
    },
    "image": "dpage/pgadmin4:9.18"
  }
}
